def runOne (line : String) : Option String :=
  match line.splitOn " " with
  | [seq, expv] =>
    let s := seq.toList.map (fun c => c.toNat - '0'.toNat)
    let got := match val s with
      | some v => VNote.showV v
      | none => "UNKNOWN"
    if got = expv then none else some (seq ++ " expected " ++ expv ++ " got " ++ got)
  | _ => some ("bad line " ++ line)

def report : String :=
  let ls := (data.splitOn "\n").filter (· ≠ "")
  let bad := ls.filterMap runOne
  s!"cases: {ls.length}, mismatches: {bad.length}\n" ++ "\n".intercalate (bad.take 20)

#eval report

end SSOS.ValueTest
